  <property name="styleSheet">
   <string notr="true">/* Poori window ka background gradient */
QMainWindow {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, 
                stop:0 #c496ff, stop:1 #67e8d0);
}

/* Central widget ko transparent rakhein taaki gradient nazar aaye */
#centralwidget {
    background: transparent;
}
/* Sabhi buttons ke liye common style */
QPushButton {
    background-color: rgba(255, 255, 255, 50); /* Bohat halka white */
    border: 1px solid rgba(255, 255, 255, 30); /* Bilkul bareek line */
    color: white; /* Text white rakhein */
    font-size: 20px;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-weight: 300;
}

/* Jab mouse button ke upar aaye */
QPushButton:hover {
    background-color: rgba(255, 255, 255, 80);
}

/* Jab button click ho */
QPushButton:pressed {
    background-color: rgba(255, 255, 255, 20);
}
QPushButton {
    /* Thora dark white / Light greyish tone */
    color: #E0E0E0; 
    
    /* Font ko mota (bold) karein taake wo prominent ho */
    font-weight: bold;
    font-size: 22px; 
    
    /* Optional: Button ke peeche halka sa dark shade */
    background-color: rgba(0, 0, 0, 20); 
    border-radius: 4px;
}QPushButton {
    /* Thora dark white / Light greyish tone */
